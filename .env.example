# Copy this file to .env and fill in real values.
# This offline pipeline's MQTT/platform integration (batch_analytics/platform_integration.py)
# loads its config from here.

# --- MQTT (requests come IN this way: channels_request, snapshot_request, zone_config, line_config) ---
MQTT_BROKER_URL=
MQTT_BROKER_PORT=8883
MQTT_USERNAME=
MQTT_PASSWORD=

# Device identity this offline pipeline registers/connects as. Must be
# distinct from other devices on the same broker (e.g. don't reuse
# GPUvarient-main's PI_UNIQUE_ID -- that's a different device/site).
PI_UNIQUE_ID=

# --- Where the saved footage lives ---
VIDEOS_ROOT=/home/hailopi/Analytics/Videos

# Where per-day JSON reports land after run_batch_analytics.py finishes
# (batch_reports/<channel>_<date>.json). channels_request uses this to hide
# already-processed days from the platform -- it only shows what's still
# waiting to be processed.
BATCH_REPORTS_DIR=batch_reports

# --- HTTP (responses go OUT this way, not over MQTT) ---
# Where channels_response gets POSTed after a channels_request.
CHANNELS_API_URL=
# Where the snapshot response (reference frame + drawn zones/lines, base64 JPEG) gets POSTed after a snapshot_request.
SNAPSHOT_API_URL=
# Where the save-ack gets POSTed after a zone_config or line_config message.
ZONE_LINE_CONFIG_API_URL=
# Where each day's full report (batch_reports/<channel>_<date>.json) gets POSTed
# once run_batch_analytics.py finishes processing that day. Optional/best-effort --
# unset just means the push is skipped; the local JSON report is unaffected either way.
PROCESSED_DAY_API_URL=

# Not implemented yet -- reserved for a future per-event (entry/exit/line-crossing)
# push, distinct from PROCESSED_DAY_API_URL's whole-day summary.
PEOPLE_COUNT_API_URL=https://cloudbases.in/analytics/php-admin/index.php/api/events/ingest
